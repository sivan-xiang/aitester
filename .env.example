# ===== AI 自动测试工具 · 配置 =====
# 复制本文件为 .env 并填写。只有管理员需要配置 LLM；测试人员只需在前端填表单。

# ---- 1. LLM（测试用例生成）----
# 任意 OpenAI 兼容接口。填你自己的 endpoint / key / model。
#
# 【推荐·零成本本地】Ollama（无需 key、完全离线）：
#   1) 安装 Ollama 并拉取模型：  ollama pull qwen2.5:7b     （中文好、支持结构化输出）
#   2) 下方填：
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# 若用 Ollama 且模型不支持 json_object 严格模式导致报错，把下一行改为 false：
LLM_JSON_MODE=true
#
# 【备选·云端】DeepSeek / OpenAI / 通义 等（需 key）：
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1    LLM_MODEL=deepseek-chat
#   通义千问: LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#
# 模型是否支持图片（截图上传后一并传给模型）。不支持则只传文字。
LLM_SUPPORTS_VISION=false

# ---- 演示 / 自检模式（可选）----
# true = 不调用任何真实 LLM，直接返回内置示例用例，用于验证「生成→执行→报告」全链路。
# 特别适合：还没装 Ollama、或想先在不接 LLM 的情况下跑通整套工具。
# 配置好真实 LLM 后请保持 false。
LLM_MOCK=false

# ---- 2. 云效 yunxiao / projex 需求来源 ----
# 从云效个人令牌获取（在 .workbuddy/mcp.json 的 yunxiao.env 里也能找到 YUNXIAO_ACCESS_TOKEN）
YUNXIAO_TOKEN=
# 组织 ID（projex 接口路径里的 organizations/{orgId}）
YUNXIAO_ORG=5f070913d2481460393369f3
# 接口 base（默认阿里云 rdc openapi，/oapi/v1 路径有效）
YUNXIAO_BASE=https://openapi-rdc.aliyuncs.com

# ---- 3. 应用上下文（可选，提升选择器准确度）----
# 指向 freighthouse 前端源码根目录；运行 npm run extract-context 会生成 app-context.json。
# 留空则跳过上下文提取，生成用例时仅靠需求文本 + PRD。
FREIGHTHOUSE_SRC=E:/freighthouse

# ---- 4. 服务端口 ----
PORT=8787
