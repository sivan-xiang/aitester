# ===== AI 自动测试工具 · 配置 =====
# 复制本文件为 .env 并填写。只有管理员需要配置 LLM；测试人员只需在前端填表单。

# ---- 1. LLM（测试用例生成）----
# 使用任意 OpenAI 兼容接口。填你自己的 endpoint / key / model。
# 常见可选项：
#   OpenAI:      https://api.openai.com/v1       sk-xxx                gpt-4o
#   DeepSeek:    https://api.deepseek.com/v1     sk-xxx                deepseek-chat
#   通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1  sk-xxx   qwen-plus
#   本地 Ollama: http://localhost:11434/v1        ollama（任意非空）     llama3
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
# 模型是否支持图片（截图上传后一并传给模型）。不支持则只传文字。
LLM_SUPPORTS_VISION=false

# ---- 2. 云效 yunxiao / projex 需求来源 ----
# 从云效个人令牌获取（在 .workbuddy/mcp.json 的 yunxiao.env 里也能找到 YUNXIAO_ACCESS_TOKEN）
YUNXIAO_TOKEN=
# 组织 ID（projex 接口路径里的 organizations/{orgId}）
YUNXIAO_ORG=5f070913d2481460393369f3
# 接口 base（默认阿里云 rdc openapi，/oapi/v1 路径有效）
YUNXIAO_BASE=https://openapi-rdc.aliyuncs.com

# ---- 3. 应用上下文（可选，提升选择器准确度）----
# 指向 freighthouse 前端源码根目录；运行 npm run extract-context 会生成 app-context.json。
# 留空则跳过上下文提取，生成用例时仅靠需求文本 + PRD。
FREIGHTHOUSE_SRC=E:/freighthouse

# ---- 4. 服务端口 ----
PORT=8787
