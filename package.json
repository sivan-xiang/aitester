{
  "name": "ai-test-kit",
  "version": "0.1.0",
  "description": "AI 自动测试工具 —— 给测试人员用：填测试地址/账号密码/需求ID，自动拉需求、AI 生成用例、Playwright 执行、生成报告",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:mock": "LLM_MOCK=true node server.js",
    "install:browsers": "npx playwright install chromium",
    "extract-context": "node scripts/extract-context.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.0",
    "dotenv": "^16.4.5"
  }
}
